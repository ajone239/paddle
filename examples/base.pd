(define (map f xs)
  (letn loop ((xs xs) (acc '()))
    (if (null? xs)
      (reverse acc)
      (loop (cdr xs) (cons (f (car xs)) acc)))))

(define (flatmap f xs)
  (foldr append '() (map f xs)))

(define (filter p xs)
  (letn loop ((xs xs) (acc '()))
    (cond
      ((null? xs) (reverse acc))
      ((p (car xs)) (loop (cdr xs) (cons (car xs) acc)))
      (else (loop (cdr xs) acc)))))

(define (range n)
  (letn loop ((n (- n 1)) (acc '()))
    (if (< n 0)
      acc
      (loop (- n 1) (cons n acc)))))

(define (foldl f init xs)
  (if (not (xs))
    init
    (foldl f (f (car xs) init) (cdr xs))))

(define (foldr f init xs)
     (define (fold xs)
          (define xxs (cdr xs))
          (if (not (xxs))
            (car xs)
            (f (car xs) (fold xxs))))
     (f init (fold xs)))

(define (sum xs) (foldl + 0 xs))

(define (reverse xs) (foldl cons '() xs))

(define (length xs)
  (letn loop ((xs xs) (l 0))
    (if (null? xs)
      l
      (loop (cdr xs) (+ l 1)))))

(define len length)

(define (> x y) (< y x))
(define (<= x y) (not (< y x)))
(define (>= x y) (not (< x y)))

(define (pow x y)
  (letn loop ((y y) (acc 1))
    (if (< y 1)
      acc
      (loop (- y 1) (* x acc)))))

(define ^ pow)

(define (cadr x) (car (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
(define (cadddr x) (car (cdr (cdr (cdr x)))))
(define (caddddr x) (car (cdr (cdr (cdr (cdr x))))))

; 10 is the byte value of ascii '\n'
; yes it's hacky but it saved me parser work
(define nl (char 10))
(define cr (char 13))

(define (read-line)
  (letn loop ((acc '()))
    (let? ((c (getchar)))
      (if (= c nl)
        (reverse acc)
        (loop (cons c acc))))))
