;; Fun Ifs

(defm (unless cond body...)
 `(if (not ,cond) (progn @body...) '()))

; macros w/o quasiquote
(defm (when cond body)
 (list 'if cond body '()))

(defmacro (when cond body...)
 `(if ,cond
      (progn @body...)
      '()))

; rec macros have to be defined like this so their args get processed
(define else #t)
(defmacro (cond pairs...)
    (define (cond2 pairs)
      (when pairs
       `(if ,(car (car pairs))
            ,(cadr (car pairs))
            ,(cond2 (cdr pairs)))))
    (cond2 pairs...))

(defmacro (or exprs...)
    (define (or2 exprs)
      (if (null? exprs)
        #f
        `(let ((test ,(car exprs)))
           (if test
               test
               ,(or2 (cdr exprs))))))
    (or2 exprs...))

(defmacro (and exprs...)
    (define (and2 exprs)
      (if (null? exprs)
        #f
        `(let ((test ,(car exprs)))
           (if (not test)
               test
               ,(and2 (cdr exprs))))))
    (and2 exprs...))

;; Let

(defm (let pairs body...)
      (define vars (map car pairs))
      (define vals (map cadr pairs))
      `((lambda ,vars @body...) @vals))

(defm (let* pairs body...)
      (define vars (map car pairs))
      (define vals (map cadr pairs))
      (define (let*2 vars vals)
        (if (|| (null? vars) (null? vals))
          `(progn @body...)
          `((lambda (,(car vars)) ,(let*2 (cdr vars) (cdr vals))) ,(car vals))))
      (let*2 vars vals))

(defm (letrec pairs body...)
      (define vars (map car pairs))
      (define vars-nil (map (lambda (v) `(,v ())) vars))
      (define set-pairs (map (lambda (p) `(set! ,(car p) ,(cadr p))) pairs))
      `(let (@vars-nil)
                @set-pairs
                @body...))

(defm (letn name pairs body...)
      (define vars (map car pairs))
      (define vals (map cadr pairs))
      `(letrec ((,name (lambda (@vars) @body...)))
         (,name @vals)))

;; For

(defm (for pair body...)
      (define bind (car pair))
      `(progn
         (define f (lambda (,bind) @body...))
         (letn loop ((xs ,(cdr pair)))
               (if (null? xs)
                 '()
                 (progn
                   (f (car xs))
                   (loop (cdr xs)))))))

(defm (for/list pair body...)
      (define bind (car pair))
      `(progn
         (define f (lambda (,bind) @body...))
         (letn loop ((xs ,(cdr pair)) (acc '()))
               (if (null? xs)
                 (reverse acc)
                 (loop (cdr xs) (cons (f (car xs)) acc))))))

(defm (for/or pair body...)
      (define bind (car pair))
      (define iter (eval (cdr pair)))
      `(progn
         (define f (lambda (,bind) @body...))
         (letn loop ((xs ,(cdr pair)))
               (if (null? xs)
                 #f
                 (progn
                   (define res (f (car xs)))
                   (if res res
                     (loop (cdr xs))))))))


;; Results monads
(define (ok v) (cons 'ok v))
(define (err e) (cons 'err e))

(define (res? r)
  (if (pair? r)
    (|| (= 'ok (car r))
        (= 'err (car r)))
    #f))
(define (ok? r)
  (if (pair? r) (= 'ok (car r)) #f))
(define (err? r)
  (if (pair? r) (= 'err (car r)) #f))
(define (unwrap r) (cdr r))

(define (unwrap-or-ret r)
  (if (ok? r) (unwrap r) r))

(define (map-ok f r)
  (if (ok? r)
    (ok (f (unwrap r)))
    r))

(define (and-then f r)
  (if (ok? r)
    (f (unwrap r))
    r))

(defm (let? bindings body...)
      (define (let?2 bindings)
        (if (null? bindings)
          `(progn @body...)
          (let ((var (car (car bindings)))
                (expr (cadr (car bindings))))
            `(let ((,var (unwrap-or-ret (,expr))))
               (if (err? ,var)
                 ,var
                 ,(let?2 (cdr bindings)))))))
      (let?2 bindings))

; Threading

(defm (-> init pairs...)
      (def (threading rpairs)
           (if (null? rpairs)
               init
               `(@(car rpairs) ,(threading (cdr rpairs)))))
      (threading (reverse pairs...)))

; Struct

(defm (struct name fields...)
      (let ((make-symbol (.\ (parts...) (string->symbol (list->string parts...)))))
        `(progn
           (define (,name @fields...) (list ',name @fields...))
           (define (,(make-symbol name "?") obj)
             (if (pair? obj) (= ',name (car obj)) #f))
           @(letn loop ((i 1) (fs fields...) (acc '()))
                  (if (null? fs)
                    acc
                    (let* ((field-name (car fs))
                           (getter
                             `(define (,(make-symbol name "-" field-name) obj)
                                (car ,(letn loop ((i i))
                                            (if (<= i 0)
                                              'obj
                                              `(cdr ,(loop (- i 1)))))))
                             ))
                      (loop (+ 1 i) (cdr fs) (cons getter acc))))))))
